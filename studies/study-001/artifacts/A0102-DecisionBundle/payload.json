{
 "supported_comparisons": [
  {
   "comparison": "temporal resection vs continued medical therapy",
   "finding": "58% to 73% free of disabling seizures at 1-2 y vs 8% and 0/23 (2 RCT families, n=118)",
   "evidence_kind": "literature_reported",
   "refs": [
    "A0063-Report"
   ],
   "strength": "randomised, small"
  },
  {
   "comparison": "long-term temporal resection",
   "finding": "66% to 72.5% seizure-free; all-procedure adult 52% at 5 y, 47% at 10 y; extratemporal lower (46%/27%, HR 2.0)",
   "evidence_kind": "literature_reported",
   "refs": [
    "A0063-Report"
   ]
  },
  {
   "comparison": "LITT in MTLE",
   "finding": "53.4% to 58.0% Engel I at 12-24 months, 3 primary-cohort families, no RCT",
   "evidence_kind": "literature_reported",
   "refs": [
    "A0063-Report"
   ]
  },
  {
   "comparison": "neurostimulation, median seizure reduction at >=12 months",
   "finding": "RNS 44-53% (1-2 y) to 75% (9 y), 67-82% real-world/post-approval; ANT-DBS 41-56% to 69-75%; VNS ~45% at 12 mo; seizure freedom RNS 18-22%, SANTE 16% (>=6 mo), VNS ~8%",
   "evidence_kind": "literature_reported",
   "refs": [
    "A0031-Report",
    "A0061-ValidationReport"
   ]
  },
  {
   "comparison": "model-guided therapeutic stimulation",
   "finding": "no clinical seizure-outcome evidence found",
   "evidence_kind": "literature_reported",
   "refs": [
    "A0016-EvidenceClaim",
    "A0055-EvidenceClaim",
    "A0056-EvidenceClaim",
    "A0057-EvidenceClaim",
