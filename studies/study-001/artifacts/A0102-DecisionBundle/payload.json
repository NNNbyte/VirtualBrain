   ]
  }
 ],
 "tradeoffs": [
  "LITT has fewer complications than open resection in all three comparative analyses but numerically lower seizure freedom (A0063).",
  "Resection: memory decline 36% in ERSET; paediatric RCT serious adverse events 33% (A0063).",
  "Neurostimulation is palliative; long-term gains are confounded by attrition, ASM and programming changes (A0031)."
 ],
 "unstable_rankings": [
  "LITT vs open resection: significant unmatched, not significant after propensity matching (RR 0.85, p=0.30), within TLE, or in nontumoral epilepsy (A0063).",
  "RNS vs ANT-DBS vs VNS: no head-to-head RCT; indirect only (A0031).",
  "Neurostimulation vs resection: different endpoints and populations; not directly rankable.",
  "Virtual-patient candidate ranking: indeterminate, no qualified model (A0098)."
 ],
